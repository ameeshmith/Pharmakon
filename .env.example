# Pharmakon MCP Server Configuration
# Copy this file to .env and fill in values as needed.

# Optional but recommended: Free API key from https://open.fda.gov/apis/authentication/
# Raises openFDA limit from 1,000/day to 120,000/day. Falls back to keyless mode if empty.
OPENFDA_API_KEY=

# Optional: NCBI API key & contact email for PubMed E-utilities polite rate limits
NCBI_API_KEY=
NCBI_EMAIL=opensource@example.com

# Database URL (defaults to local SQLite; swappable with PostgreSQL e.g. postgresql+psycopg://...)
DATABASE_URL=sqlite:///./pharmakon.db

# JWT signing secret for web dashboard sessions (override in production)
JWT_SECRET_KEY=change-me-in-production-use-a-32-byte-random-hex-string
JWT_EXPIRE_MINUTES=1440

# Rate limits per API key
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=1000

# Upstream HTTP cache TTL (seconds)
CACHE_TTL_SECONDS=3600

# Server & CORS settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Optional: For running live LLM evals in /evals/run_evals.py
ANTHROPIC_API_KEY=

